{
  "permissions": {
    "allow": [
      "Bash(get_pr_status *)",
      "Bash(get_jenkins_console *)",
      "Bash(get_jenkins_build_status *)",
      "Bash(rebuild_jenkins_job *)",
      "Bash(get_last_build_number *)",
      "Bash(get_allure_report *)",
      "Bash(wait_for_jenkins_build *)",
      "Bash(wait_for_jenkins_pr_check *)",
      "Bash(wait_for_gh_run *)",
      "Bash(wait_for_pr_check *)",
      "Bash(update_github_status_for_jenkins *)",
      "Bash(is_test_flaky *)",
      "Bash(search_flaky_tests *)",
      "Bash(get_flaky_stats *)",
      "Bash(get_collection_tests *)",
      "Bash(quick_flaky_check *)",
      "Bash(show_affected_projects *)",
      "Bash(run_affected_tests *)",
      "Bash(run_project_tests *)",
      "Bash(rerun_failed_pr_jobs *)",
      "Bash(watch_pr *)",
      "Bash(list_recent_runs *)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(git branch *)",
      "Bash(git log *)",
      "Bash(git diff *)"
    ],
    "defaultMode": "auto"
  },
  "enableAllProjectMcpServers": false,
  "enabledMcpjsonServers": [
    "jira",
    "nx-mcp",
    "sentry",
    "coralogix-browser",
    "coralogix-cloud"
  ],
  "disabledMcpjsonServers": [
    "chrome-devtools",
    "island-canary",
    "island-canary-headless",
    "island-canary-ext",
    "lite-chrome",
    "page-devtools"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/block-big-reads.py",
            "statusMessage": "Guarding against big-file reads..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/island/island-service/current/island-aiguard-hook",
            "args": [
              "claude-code"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/check-comment-budget.js",
            "statusMessage": "Checking comment budget..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/island/island-service/current/island-aiguard-hook",
            "args": [
              "claude-code"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/island/island-service/current/island-aiguard-hook",
            "args": [
              "claude-code"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/island/island-service/current/island-aiguard-hook",
            "args": [
              "claude-code"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/check-comment-budget.js",
            "statusMessage": "Checking comment budget..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/island/island-service/current/island-aiguard-hook",
            "args": [
              "claude-code"
            ],
            "timeout": 15
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); remaining=$(echo \u0022$input\u0022 | jq -r \u0027.context_window.remaining_percentage // empty\u0027); [ -n \u0022$remaining\u0022 ] \u0026\u0026 printf \u0022Context: %.0f%% remaining\u0022 \u0022$remaining\u0022"
  },
  "enabledPlugins": {
    "ai-chat-team@za-dev-utils": true,
    "brain@brain": true
  },
  "extraKnownMarketplaces": {
    "za-dev-utils": {
      "source": {
        "source": "github",
        "repo": "zeroabstraction/dev-utils"
      }
    },
    "brain": {
      "source": {
        "source": "directory",
        "path": "/Users/oryedidia/work/brain"
      }
    }
  },
  "effortLevel": "high",
  "autoCompactWindow": 1000000,
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "autoCompactEnabled": true,
  "skipAutoPermissionPrompt": true,
  "model": "claude-opus-5-5"
}